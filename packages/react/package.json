{
  "name": "@gnomon-ui/react",
  "version": "0.1.0-alpha.2",
  "description": "React compound components and hooks for Gnomon UI.",
  "license": "MIT",
  "homepage": "https://ray0907.github.io/gnomon-ui/docs/adapters/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray0907/gnomon-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Ray0907/gnomon-ui/issues"
  },
  "keywords": ["accessibility", "headless", "react", "spatial-ui"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@gnomon-ui/core": "workspace:*",
    "@types/react": "19.2.17",
    "react": "19.2.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@gnomon-ui/core": "^0.1.0-alpha.2",
    "react": ">=18.3.0 <20"
  }
}
