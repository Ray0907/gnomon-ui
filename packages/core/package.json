{
  "name": "@gnomon-ui/core",
  "version": "0.1.0-alpha.1",
  "description": "Framework-agnostic state and interaction contracts for spatial interfaces.",
  "license": "MIT",
  "homepage": "https://ray0907.github.io/gnomon-ui/docs/primitives/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray0907/gnomon-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Ray0907/gnomon-ui/issues"
  },
  "keywords": ["accessibility", "headless", "spatial-ui", "state"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
