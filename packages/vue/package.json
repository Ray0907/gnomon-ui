{
  "name": "@gnomon-ui/vue",
  "version": "0.1.0-alpha.2",
  "description": "Vue components and composables for Gnomon UI.",
  "license": "MIT",
  "homepage": "https://ray0907.github.io/gnomon-ui/docs/adapters/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray0907/gnomon-ui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Ray0907/gnomon-ui/issues"
  },
  "keywords": ["accessibility", "headless", "spatial-ui", "vue"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@gnomon-ui/core": "workspace:*",
    "typescript": "5.9.3",
    "vue": "3.5.24"
  },
  "peerDependencies": {
    "@gnomon-ui/core": "^0.1.0-alpha.2",
    "vue": ">=3.4.0 <4"
  }
}
